{
  "manifest_version": 3,
  "name": "Org Capture",
  "version": "0.3.0",
  "description": "Capture the current page and selected text in Emacs via org-protocol.",
  "homepage_url": "https://github.com/sprig/org-capture-extension",

  "background": {
    "service_worker": "background.js"
  },

  "permissions": ["activeTab", "storage", "scripting"],

  "options_ui": {
    "page": "options.html"
  },

  "action": {},

  "commands": {
    "_execute_action": {
      "description": "Capture current page with org-capture",
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      }
    }
  }
}
